# Required. Any OpenAI-compatible provider works: OpenAI, Groq, OpenRouter,
# a self-hosted Ollama/llama.cpp server, etc.
CLIENT_API_KEY=xx

# Optional. Leave unset to use the real OpenAI API. Point at another
# OpenAI-compatible endpoint to switch providers, e.g.:
#   Groq:               https://api.groq.com/openai/v1
#   OpenRouter:         https://openrouter.ai/api/v1
#   Self-hosted Ollama: http://localhost:11434/v1
#   Anthropic (Claude): https://api.anthropic.com/v1/
#     (compatibility layer for quick testing, some OpenAI-specific params
#     aren't supported; use the native `anthropic` SDK for production use)
MODEL_BASE_URL=

# Optional. Defaults to gpt-4o-mini. Set to match the provider above,
# e.g. claude-sonnet-5 for Anthropic, llama-3.3-70b-versatile for Groq.
MODEL_NAME=

# Optional. Model generation parameters
MAX_TOKENS=512
TEMPERATURE=0.3